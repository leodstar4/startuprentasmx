# Renta MX — copia este archivo a .env y rellénalo. .env está en .gitignore.
# El runtime no usa LLM ni red; estas variables son solo de configuración/persistencia.

# Persistencia (producción): cadena de conexión de Supabase Postgres.
# Sin definir -> store JSON efímero (solo demo). Settings -> Database -> Connection string -> URI.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres

# Sal para el hash de la IP en la evidencia de firma (nunca se guarda la IP en claro). Mantener estable.
# MX_IP_SALT=

# Orígenes CORS exactos extra, separados por coma (solo para setup split dev; mismo origen no requiere CORS).
# ALLOWED_ORIGINS=

# Ruta del build del frontend que sirve el monolito (default frontend/.output/public).
# FRONTEND_DIST=frontend/.output/public

# Directorio de artefactos de runtime (reporte de validación, store JSON por defecto).
# OUT_DIR=out
