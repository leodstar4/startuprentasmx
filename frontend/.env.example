# Renta MX — Frontend environment variables
# Copy to .env.local (git-ignored) for local overrides.

# API base URL. Leave empty when running the monolith (FastAPI serves both API + frontend on the
# same origin). Set to e.g. http://127.0.0.1:8000 when running the frontend dev server separately.
VITE_API_BASE=

# Demo banner: shows "🚧 Demo — datos reales CDMX + Federal..." at the top of every page.
# Set to "true" for the public demo deploy; leave unset or "false" for production.
VITE_IS_DEMO=false
